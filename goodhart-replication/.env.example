# Copy to .env and fill in your gateway credentials. Never commit .env.
# The gateway must expose these model aliases through the OpenAI Responses API.
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://your-gateway.example/v1

# Optional, only for --models fable opus.
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_BASE_URL=https://your-gateway.example
